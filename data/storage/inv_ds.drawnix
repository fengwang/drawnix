        {
          "id": "sFKYw",
          "type": "mind_child",
          "data": {
            "topic": {
              "children": [
                {
                  "text": "3. Mathematical Framework"
                }
              ],
              "type": "paragraph"
            }
          },
          "children": [
            {
              "id": "AreWJ",
              "type": "mind_child",
              "data": {
                "topic": {
                  "children": [
                    {
                      "text": "Wave Function Propagation"
                    }
                  ],
                  "type": "paragraph"
                }
              },
              "children": [
                {
                  "id": "ZEpyk",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "$$\\psi(t, \u000bec{k}_t, U_g) = S(t, \u000bec{k}_t, U_g) \\psi(0)$$"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                }
              ]
            },
            {
              "id": "fZixJ",
              "type": "mind_child",
              "data": {
                "topic": {
                  "children": [
                    {
                      "text": "Scattering Matrix"
                    }
                  ],
                  "type": "paragraph"
                }
              },
              "children": [
                {
                  "id": "xBPGp",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "$$S(t, \u000bec{k}_t, U_g) = e^{i\\pi\\lambda t A(\u000bec{k}_t, U_g)}$$"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                }
              ]
            },
            {
              "id": "FNQSc",
              "type": "mind_child",
              "data": {
                "topic": {
                  "children": [
                    {
                      "text": "Bethe Matrix A"
                    }
                  ],
                  "type": "paragraph"
                }
              },
              "children": [
                {
                  "id": "bmyyP",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "Contains structure factors $$U_g$$"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                },
                {
                  "id": "PmmcW",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "Depends on beam tilt $$\u000bec{k}_t$$"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                }
              ]
            },
            {
              "id": "KCTFh",
              "type": "mind_child",
              "data": {
                "topic": {
                  "children": [
                    {
                      "text": "Optimization Problem"
                    }
                  ],
                  "type": "paragraph"
                }
              },
              "children": [
                {
                  "id": "AKmXY",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "Merit function $$\\chi^2(t, U_g, \u0007lpha, \beta)$$"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                },
                {
                  "id": "nnsih",
                  "type": "mind_child",
                  "data": {
                    "topic": {
                      "children": [
                        {
                          "text": "Minimizes difference between simulated and experimental intensities"
                        }
                      ],
                      "type": "paragraph"
                    }
                  },
                  "children": []
                }
              ]
            }
          ]
