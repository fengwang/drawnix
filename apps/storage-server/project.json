{
  "name": "storage-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storage-server/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/storage-server"],
      "options": {
        "command": "tsc --project apps/storage-server/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/storage-server/main.js"
      },
      "dependsOn": ["build"]
    }
  },
  "tags": []
}
